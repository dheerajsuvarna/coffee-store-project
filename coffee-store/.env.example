# ── Database ──────────────────────────────────────────────────────────────────
# Railway PostgreSQL plugin sets this automatically.
# Format: postgres://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Railway Redis plugin sets this automatically.
# Used for session persistence — admin logins survive backend restarts.
REDIS_URL=

# ── Secrets (generate with: openssl rand -hex 32) ────────────────────────────
JWT_SECRET=
COOKIE_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Set these to your actual Railway service URLs in production.
STORE_CORS=https://<storefront-railway-url>
ADMIN_CORS=https://<backend-railway-url>
AUTH_CORS=https://<backend-railway-url>,https://<storefront-railway-url>

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Seeding (first deploy only) ───────────────────────────────────────────────
# Set to "true" for the first deploy to seed the database and create the admin user.
# Remove or set to "false" after the first successful deploy to prevent re-seeding.
# SEED_ON_START=true

# ── Admin credentials (set in seed.ts) ───────────────────────────────────────
# Default: admin@bergkraft.com / BergkraftAdmin123!
# Admin panel: https://<backend-railway-url>/app
