# ── Backend URL (server-side / SSR) ──────────────────────────────────────────
# Used by Next.js server components and API routes to reach the backend.
# On Railway this should be the internal private URL of the backend service.
MEDUSA_BACKEND_URL=https://<backend-railway-url>

# ── Backend URL (client-side, baked into JS bundle at BUILD TIME) ─────────────
# Must be set as a build arg in Railway (Build → Variables) — not a runtime env var.
# This is the public URL that the browser will use to call the backend.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://<backend-railway-url>

# ── Publishable API Key (baked into JS bundle at BUILD TIME) ──────────────────
# Must be set as a build arg in Railway (Build → Variables) — not a runtime env var.
# Get this from the Medusa admin panel: /app → Settings → API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# ── Storefront base URL ───────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://<storefront-railway-url>

# ── Default region ────────────────────────────────────────────────────────────
# Must match a region handle created by the seed script (e.g. "us" or "eu").
NEXT_PUBLIC_DEFAULT_REGION=us

# ── Cache revalidation secret ─────────────────────────────────────────────────
# Used to authenticate on-demand revalidation requests from the backend.
REVALIDATE_SECRET=
